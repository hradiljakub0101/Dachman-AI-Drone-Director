<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key><string>Dachman Drone Director</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>UILaunchScreen</key><dict/>
    <key>NSMicrophoneUsageDescription</key><string>Hlasové povely pro režiséra letu.</string>
    <key>NSSpeechRecognitionUsageDescription</key><string>Převod českých hlasových povelů na bezpečné filmové manévry.</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>Poloha je používána pro telemetrii a bezpečnost letu.</string>
    <key>NSBluetoothAlwaysUsageDescription</key><string>Připojení a diagnostika podporovaného DJI příslušenství.</string>
    <key>DJISDKAppKey</key><string>__DJI_APP_KEY__</string>
    <key>UISupportedExternalAccessoryProtocols</key>
    <array>
        <string>com.dji.video</string>
        <string>com.dji.protocol</string>
        <string>com.dji.common</string>
    </array>
    <key>NSAppTransportSecurity</key>
    <dict><key>NSAllowsArbitraryLoads</key><true/></dict>
</dict>
</plist>
